FROM node:22-alpine AS builder

# Install pnpm at the version specified in packageManager
RUN npm install -g pnpm@10.33.2

WORKDIR /app

# Copy root configuration files
COPY package.json pnpm-lock.yaml turbo.json ./

# Copy all workspace packages
COPY apps/server ./apps/server
COPY apps/client_web ./apps/client_web
COPY packages/types ./packages/types

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build server and client
RUN pnpm --filter @easy-update/server build
RUN pnpm --filter @easy-update/client_web build

# Final stage
FROM node:22-alpine

WORKDIR /app

# Copy built server from builder
COPY --from=builder /app/apps/server/dist ./apps/server/dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY --from=builder /app/apps/server/package.json ./apps/server/

# Copy built client static files
COPY --from=builder /app/apps/client_web/dist ./apps/client_dist

# Expose the server port
EXPOSE 4000

# Start the server
CMD ["node", "apps/server/dist/index.js"]
