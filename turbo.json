{
  "$schema": "https://turborepo.org/schema.json",
  "pipeline": {
    "dev": {
      "dependsOn": [],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "apps/server/dist/**",
        "apps/client/dist/**",
        "packages/**/dist/**"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "db:seed": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
