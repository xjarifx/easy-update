# Stage 1: Build the client
FROM node:22-alpine AS client-builder

RUN npm install -g pnpm@10.33.2

WORKDIR /app

# Copy root config files
COPY package.json pnpm-lock.yaml turbo.json ./

# Copy client and shared types workspace packages
COPY apps/client_web ./apps/client_web
COPY packages/types ./packages/types

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build the client
RUN pnpm --filter @easy-update/client_web build

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Copy the built client files from the builder stage
COPY --from=client-builder /app/apps/client_web/dist /usr/share/nginx/html

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
